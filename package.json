    "@earendil-works/pi-tui": ">=0.84.1 <0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "^24.0.0",
    "jiti": "^2.7.0",
