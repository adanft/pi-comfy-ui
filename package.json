{
  "name": "pi-comfy-ui",
  "version": "0.3.0",
  "description": "Comfortable input and interactive panel styling for Pi's TUI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adanft/pi-comfy-ui"
  },
  "bugs": {
    "url": "https://github.com/adanft/pi-comfy-ui/issues"
  },
  "homepage": "https://github.com/adanft/pi-comfy-ui#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "tui",
    "theme"
  ],
  "files": [
